# --- LLM (Groq) -------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Groq deprecated the entire Llama line on 2026-08-16. /health surfaces the
# model actually in use so a deprecation is a five-second diagnosis.
GROQ_MODEL=openai/gpt-oss-120b

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medibot_documents

# --- Data -------------------------------------------------------------------
# Paths are resolved relative to the repository root.
SQLITE_PATH=data/mediassist.db
DOCUMENTS_PATH=data/documents

# --- Auth -------------------------------------------------------------------
# Demo-grade. Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-any-non-demo-use
JWT_EXPIRY_HOURS=8

# --- Models -----------------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
# Note: L6, not L-6. The `L-6-v2` spelling copied across most tutorials is the
# legacy repo name.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Retrieval funnel -------------------------------------------------------
RETRIEVAL_TOP_K=20
RERANK_TOP_K=3
MAX_TOKENS=512

# --- Dev flags --------------------------------------------------------------
# Set to 1 to log the hybrid rank -> rerank score -> new rank table per query.
MEDIBOT_LOG_RERANK=0

# Relevance floor on the cross-encoder score (0-1). Below this, the role-scoped
# refusal is returned instead of an answer improvised from loosely-related text.
RERANK_MIN_SCORE=0.05
