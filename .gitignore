# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environment (never commit secrets) ---
.env
.env.local
*.env
!.env.example
!.env.local.example

# --- Qdrant (Docker volume) ---
qdrant_storage/

# --- Docling / model caches ---
.cache/
models/

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-error.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Generated editor-tooling scaffolding ---
# `next dev` writes assistant instruction files into frontend/ on every run
# (see node_modules/next/dist/server/lib/generate-agent-files.js) and re-creates
# them if deleted, so they have to be ignored rather than removed. The frontend
# has no hand-written Markdown of its own - all project documentation lives in
# README.md and docs/ at the repository root.
frontend/*.md
